# Environment Variables — PLACEHOLDER FILE
# Copy this to .env (never commit .env with real secrets)

# ============================================================
# BLYNK CONFIGURATION
# ============================================================
BLYNK_AUTH_TOKEN=your_blynk_auth_token_here
BLYNK_SERVER=blynk.cloud

# ============================================================
# TELEGRAM BOT CONFIGURATION
# ============================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ============================================================
# BACKEND SERVER
# ============================================================
BACKEND_PORT=3001
VITE_BACKEND_URL=http://localhost:3001

# ============================================================
# DEMO MODE (set to "true" to use simulated data)
# ============================================================
VITE_DEMO_MODE=true

# ============================================================
# DEVICE CONFIGURATION
# ============================================================
DEVICE_NAME=PawSense360-001
WIFI_SSID=your_wifi_ssid_here
WIFI_PASSWORD=your_wifi_password_here
